{
  "name": "secure-it",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "Plano de control y servidor MCP para operar infraestructura sin exponer credenciales al agente.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "secure-it": "apps/mcp/dist/index.js",
    "secure-it-mcp": "apps/mcp/dist/index.js",
    "secure-it-admin": "apps/admin/dist/index.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "mcp": "node apps/mcp/dist/index.js",
    "admin": "node apps/admin/dist/index.js",
    "dev:mcp": "npm run dev:mcp:stdio",
    "dev:mcp:stdio": "tsx apps/mcp/src/index.ts",
    "dev:mcp:http": "tsx apps/mcp/src/http-entry.ts",
    "dev:admin": "tsx apps/admin/src/index.ts",
    "start:mcp:http": "node apps/mcp/dist/http-entry.js",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test",
    "verify:packages": "node scripts/verify-packages.mjs",
    "release:verify": "npm run check && npm run build && npm run verify:packages && npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {}
}
