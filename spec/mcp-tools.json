{
  "serverInfo": {
    "name": "secure-it",
    "version": "0.1.0"
  },
  "capabilities": {
    "tools": {
      "listChanged": true
    }
  },
  "tools": [
    {
      "name": "secureit.servers.list",
      "title": "Listar servidores autorizados",
      "description": "Lista la vista reducida del inventario que puede ver la identidad actual. Nunca devuelve credenciales, bindings o referencias de secretos.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "environment": {
            "type": "string",
            "enum": ["dev", "test", "staging", "prod"]
          },
          "state": {
            "type": "string",
            "enum": ["pending", "managed", "quarantined", "retired"]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["servers", "has_more"],
        "properties": {
          "servers": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["server_id", "name", "environment", "criticality", "state", "connection_mode"],
              "properties": {
                "server_id": { "type": "string", "format": "uuid" },
                "name": { "type": "string" },
                "environment": { "type": "string" },
                "criticality": { "type": "string" },
                "state": { "type": "string" },
                "connection_mode": { "type": "string" }
              }
            }
          },
          "next_cursor": { "type": ["string", "null"] },
          "has_more": { "type": "boolean" }
        }
      }
    },
    {
      "name": "secureit.servers.get",
      "title": "Consultar un servidor",
      "description": "Devuelve metadatos no secretos de un servidor autorizado por su UUID lógico.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id", "name", "environment", "owner", "criticality", "state", "connection_mode", "labels"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "environment": { "type": "string" },
          "owner": { "type": "string" },
          "criticality": { "type": "string" },
          "state": { "type": "string" },
          "connection_mode": { "type": "string" },
          "labels": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    {
      "name": "secureit.access_profiles.list",
      "title": "Listar perfiles de acceso",
      "description": "Lista perfiles lógicos utilizables para altas. No devuelve principales reales, rutas del gestor de secretos o material de autenticación.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connection_mode": {
            "type": "string",
            "enum": ["local_agent", "ssh_cert", "cloud_api"]
          },
          "environment": {
            "type": "string",
            "enum": ["dev", "test", "staging", "prod"]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profiles"],
        "properties": {
          "profiles": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["access_profile_id", "name", "connection_mode", "max_ttl_seconds"],
              "properties": {
                "access_profile_id": { "type": "string", "format": "uuid" },
                "name": { "type": "string" },
                "connection_mode": { "type": "string" },
                "max_ttl_seconds": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    {
      "name": "secureit.servers.add",
      "title": "Registrar un servidor",
      "description": "Registra un servidor en el inventario. Si proporcionas 'username' y 'password', la credencial se guarda automáticamente de forma cifrada y el servidor queda listo ('managed') para operar de inmediato.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,252}[a-zA-Z0-9]$",
            "maxLength": 254,
            "description": "Nombre lógico o IP del servidor (ej: web-prod-01 o 192.168.1.50)."
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Usuario SSH de login (ej: root, ubuntu, admin)."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "description": "Contraseña SSH de login o contenido de la clave privada SSH."
          },
          "secret_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "description": "Valor alternativo del secreto o clave privada SSH."
          },
          "credential_alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Alias opcional para la credencial creada. Si se omite, se genera como 'nombre:usuario'."
          },
          "environment": {
            "type": "string",
            "enum": ["dev", "test", "staging", "prod"],
            "default": "prod"
          },
          "owner": { "type": "string", "minLength": 1, "maxLength": 128, "default": "admin" },
          "criticality": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "default": "medium"
          },
          "connection_mode": {
            "type": "string",
            "enum": ["local_agent", "ssh_cert", "cloud_api"],
            "default": "local_agent",
            "description": "Modo de conexión. Usa 'local_agent' (por defecto) para servidores SSH con usuario/contraseña o clave estática."
          },
          "management_endpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "port"],
            "properties": {
              "address": { "type": "string", "minLength": 1, "maxLength": 253 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22 }
            }
          },
          "expected_host_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Fingerprint SSH del host. Si se omite, el sistema la descubre/asigna automáticamente."
          },
          "access_profile_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID del perfil de acceso. Si se omite, se asigna automáticamente el perfil predeterminado para el modo de conexión."
          },
          "labels": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": { "type": "string", "maxLength": 128 }
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500, "default": "Alta de servidor por agente MCP" },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id", "state", "admin_action_required", "next_step"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" },
          "state": { "type": "string", "enum": ["pending", "managed"] },
          "admin_action_required": { "type": "boolean" },
          "next_step": { "type": "string", "maxLength": 500 },
          "credential_id": { "type": ["string", "null"] }
        }
      }
    },
    {
      "name": "secureit.servers.enrollment_status",
      "title": "Consultar estado de enrolamiento",
      "description": "Informa los pasos de alta pendientes sin devolver tokens de bootstrap ni credenciales.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id", "state", "binding_ready", "identity_ready", "admin_action_required"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" },
          "state": { "type": "string" },
          "binding_ready": { "type": "boolean" },
          "identity_ready": { "type": "boolean" },
          "admin_action_required": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    },
    {
      "name": "secureit.servers.verify",
      "title": "Verificar identidad y acceso",
      "description": "Solicita una verificación ciega de identidad y conectividad para un servidor pendiente. Nunca usa Trust On First Use.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id", "reason", "idempotency_key"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 8, "maxLength": 500 },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "status", "server_id"],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["queued", "awaiting_approval", "running", "completed", "failed"] },
          "server_id": { "type": "string", "format": "uuid" }
        }
      }
    },
    {
      "name": "secureit.servers.remove",
      "title": "Eliminar un servidor del inventario",
      "description": "Elimina de forma segura un servidor registrado en el inventario. Requiere motivo de auditoría y clave de idempotencia.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id", "reason", "idempotency_key"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 8, "maxLength": 500 },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_id", "removed", "message"],
        "properties": {
          "server_id": { "type": "string", "format": "uuid" },
          "removed": { "type": "boolean" },
          "message": { "type": "string", "maxLength": 500 }
        }
      }
    },
    {
      "name": "secureit.actions.list",
      "title": "Listar acciones SSH tipadas",
      "description": "Lista las acciones revisadas que la identidad actual puede solicitar.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "environment": {
            "type": "string",
            "enum": ["dev", "test", "staging", "prod"]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actions"],
        "properties": {
          "actions": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "version", "description", "risk", "parameter_schema"],
              "properties": {
                "action_id": { "type": "string" },
                "version": { "type": "integer", "minimum": 1 },
                "description": { "type": "string" },
                "risk": { "type": "string", "enum": ["read", "low", "high", "critical"] },
                "parameter_schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    {
      "name": "secureit.ssh.execute_action",
      "title": "Ejecutar una acción SSH tipada",
      "description": "Solicita una acción revisada sobre servidores exactos. No acepta hosts, usuarios, opciones SSH o credenciales.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "action_version", "server_ids", "parameters", "reason", "idempotency_key"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "action_version": { "type": "integer", "minimum": 1 },
          "server_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "parameters": { "type": "object" },
          "reason": { "type": "string", "minLength": 8, "maxLength": 500 },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "status", "risk", "manifest_hash", "target_count"],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["queued", "awaiting_approval", "running", "completed", "failed"] },
          "risk": { "type": "string", "enum": ["read", "low", "high", "critical"] },
          "manifest_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "target_count": { "type": "integer", "minimum": 1 },
          "approval_request_id": { "type": ["string", "null"], "format": "uuid" }
        }
      }
    },
    {
      "name": "secureit.ssh.execute_command",
      "title": "Ejecutar un script SSH",
      "description": "Ejecuta un script o comando SSH en los servidores administrados sin revelar credenciales. Ejecuta directamente el comando y retorna los resultados inmediatamente.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["script"],
        "properties": {
          "server_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" },
            "description": "Lista de IDs de servidores objetivo. Si se omite, se aplican a los servidores enrolados."
          },
          "interpreter": {
            "type": "string",
            "enum": ["posix-sh", "bash-restricted", "powershell-constrained"],
            "default": "posix-sh"
          },
          "script": { "type": "string", "minLength": 1, "maxLength": 32768, "description": "Comando o script a ejecutar (ej: ls, pwd, df -h, uptime)." },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500, "default": "Ejecución de comando por agente" },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "status", "risk", "script_digest", "manifest_hash", "target_count"],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["awaiting_approval", "queued", "running", "completed", "failed"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "script_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "manifest_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "target_count": { "type": "integer", "minimum": 1, "maximum": 20 },
          "approval_request_id": { "type": ["string", "null"], "format": "uuid" },
          "results": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["server_id", "server_alias", "status", "truncated", "secret_detected"],
              "properties": {
                "server_id": { "type": "string", "format": "uuid" },
                "server_alias": { "type": "string" },
                "status": { "type": "string" },
                "exit_code": { "type": ["integer", "null"] },
                "stdout_excerpt": { "type": ["string", "null"], "maxLength": 65536 },
                "stderr_excerpt": { "type": ["string", "null"], "maxLength": 16384 },
                "truncated": { "type": "boolean" },
                "secret_detected": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    {
      "name": "secureit.jobs.get",
      "title": "Consultar un trabajo",
      "description": "Devuelve estado y resultados sanitizados de un trabajo que la identidad actual puede consultar.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id"],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "include_output": { "type": "boolean", "default": false }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "status", "created_at", "expires_at", "results"],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["awaiting_approval", "queued", "running", "completed", "failed", "cancelled", "expired"] },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "results": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["server_id", "server_alias", "status", "truncated", "secret_detected"],
              "properties": {
                "server_id": { "type": "string", "format": "uuid" },
                "server_alias": { "type": "string" },
                "status": { "type": "string" },
                "exit_code": { "type": ["integer", "null"] },
                "stdout_excerpt": { "type": ["string", "null"], "maxLength": 65536 },
                "stderr_excerpt": { "type": ["string", "null"], "maxLength": 16384 },
                "truncated": { "type": "boolean" },
                "secret_detected": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    {
      "name": "secureit.jobs.cancel",
      "title": "Cancelar un trabajo",
      "description": "Solicita la cancelación de un trabajo autorizado. La respuesta indica si la detención fue posible.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "reason", "idempotency_key"],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 8, "maxLength": 500 },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "status", "cancellation_requested"],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "cancellation_requested": { "type": "boolean" }
        }
      }
    },
    {
      "name": "secureit.credentials.rotate",
      "title": "Rotar una credencial sin verla",
      "description": "Solicita una rotación por binding lógico. No acepta ni devuelve valores de credenciales.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_ids", "access_profile_id", "reason", "idempotency_key"],
        "properties": {
          "server_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "access_profile_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 8, "maxLength": 500 },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rotation_job_id", "status", "target_count", "admin_action_required"],
        "properties": {
          "rotation_job_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["awaiting_approval", "queued", "running", "completed", "failed"] },
          "target_count": { "type": "integer", "minimum": 1, "maximum": 20 },
          "opaque_version_id": { "type": ["string", "null"], "maxLength": 256 },
          "verified_at": { "type": ["string", "null"], "format": "date-time" },
          "admin_action_required": { "type": "boolean" }
        }
      }
    },
    {
      "name": "secureit.credentials.add",
      "title": "Registrar o importar una credencial",
      "description": "Registra una credencial de acceso (clave SSH o contraseña de usuario). Al agregar un servidor con usuario y contraseña, usa esta herramienta primero especificando el alias (ej: 'ssh-servidor:usuario' o 'usuario@servidor') y el secreto en secret_value.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias"],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Identificador o alias de la credencial (ej: 'ssh-web-01:admin' o 'admin@192.168.1.100')."
          },
          "type": {
            "type": "string",
            "enum": ["ssh_key", "db_password", "api_token", "ca_private_key"],
            "default": "ssh_key",
            "description": "Tipo de credencial. Usa 'ssh_key' o 'db_password' para contraseñas de login o claves SSH."
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "default": "admin"
          },
          "environment": {
            "type": "string",
            "enum": ["dev", "test", "staging", "prod"],
            "default": "prod"
          },
          "exportable": {
            "type": "boolean",
            "default": true
          },
          "secret_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "description": "La contraseña de usuario o el contenido de la clave privada SSH."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_id", "alias", "type", "owner", "environment", "status", "version", "masked_value"],
        "properties": {
          "credential_id": { "type": "string" },
          "alias": { "type": "string" },
          "type": { "type": "string" },
          "owner": { "type": "string" },
          "environment": { "type": "string" },
          "status": { "type": "string" },
          "version": { "type": "integer" },
          "masked_value": { "type": "string" }
        }
      }
    }
  ]
}
