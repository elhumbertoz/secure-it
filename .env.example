# Solo para la demostración local. No introduzca credenciales reales.
SECUREIT_MODE=demo
SECUREIT_LOG_LEVEL=info
# Obligatoria al crear la primera base persistente (mínimo 12 caracteres).
SECUREIT_ADMIN_USERNAME=admin
SECUREIT_ADMIN_PASSWORD=replace-with-a-long-random-password
# Obligatoria para persistir credenciales cifradas. Use un gestor de secretos.
SECUREIT_MASTER_KEY=replace-with-at-least-32-random-bytes
SECUREIT_HTTP_HOST=127.0.0.1
SECUREIT_HTTP_PORT=3000
SECUREIT_MCP_PUBLIC_URL=https://secure-it.example/mcp
SECUREIT_OIDC_ISSUER=https://identity.example/realms/secure-it
SECUREIT_OIDC_AUDIENCE=https://secure-it.example/mcp
SECUREIT_OIDC_JWKS_URI=https://identity.example/realms/secure-it/protocol/openid-connect/certs
SECUREIT_OIDC_AUTHORIZATION_URL=https://identity.example/realms/secure-it/protocol/openid-connect/auth
SECUREIT_OIDC_TOKEN_URL=https://identity.example/realms/secure-it/protocol/openid-connect/token
SECUREIT_ALLOWED_HOSTS=secure-it.example,127.0.0.1
SECUREIT_ALLOWED_ORIGINS=https://client.example
SECUREIT_REQUEST_MAX_BYTES=65536
SECUREIT_RATE_LIMIT_WINDOW_MS=60000
SECUREIT_RATE_LIMIT_MAX=60
POSTGRES_DB=secureit_demo
POSTGRES_USER=secureit_demo
POSTGRES_PASSWORD=demo-only-not-for-real-secrets
